{
  "name": "agents",
  "version": "0.1.0",
  "scope": "global",
  "default": true,
  "description": "Grafo de orquestación con ejecución real: orquestador, nodos, especializados y subagentes, skills con cuerpo de prompt, modelo por agente y handoffs.",
  "contracts": ["agents.grafo"],
  "transports": ["cli", "web"],
  "patterns": ["single-orchestrator", "fail-closed"],
  "config_file": "agents.config.json",
  "editables": ["manifest.json", "index.ts", "config.ts", "handoff.ts", "ejecucion.ts", "skills.ts", "defensa.ts"],
  "cli": ["agents list", "agents add <id> <rol>", "agents pause <id> [activo|pausado]", "agents skill <id> <skill>", "agents link <de> <a> [tipo]", "agents define <id> <campo> <valor>"]
}
